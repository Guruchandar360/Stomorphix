# AI explanation provider (optional; deterministic summaries work without a key)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional model override. Leave blank to use models/yolo11s_stomata/weights/best.pt
STOMORPHIX_MODEL_PATH=

# Firebase web login
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Require verified Firebase ID tokens in production
REQUIRE_AUTH=false
FIREBASE_PROJECT_ID=

# Abuse protection and capacity
ANALYSIS_RATE_LIMIT=60
ANALYSIS_RATE_WINDOW_SECONDS=60
MAX_INFERENCE_QUEUE=8
INFERENCE_QUEUE_TIMEOUT_SECONDS=30
MAX_DETECTIONS=1000
MAX_BATCH_IMAGES=30
MAX_PENDING_BATCHES=50
MAX_IMAGE_BYTES=26214400

# Generated artifact expiration
OUTPUT_TTL_SECONDS=86400
BATCH_TTL_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=900
